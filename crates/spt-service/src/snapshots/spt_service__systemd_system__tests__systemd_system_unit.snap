---
source: crates/spt-service/src/systemd_system.rs
expression: out
---
[Unit]
Description=spt — SMTP relay tunnel
Documentation=https://github.com/supermarsx/ssh-perma-tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/spt service run --config /etc/spt/relay.toml
WorkingDirectory=/var/lib/spt
# State dir must be writable under the sandbox below; StateDirectory
# creates and binds /var/lib/spt (0700, owned by User=).
StateDirectory=spt
ReadWritePaths=/var/lib/spt /var/log/spt
Environment="SPT_STATE_DIR=/var/lib/spt"
Environment="RUST_LOG=info"
Environment="SPT_STATE_DIR=/var/lib/spt"
User=spt
Group=spt
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Allow binding privileged ports (<1024) for forwards under NoNewPrivileges=true.
AmbientCapabilities=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
