#!/sbin/openrc-run
# OpenRC init script for spt-relay
# Generated by spt â do not edit by hand; re-run `spt service install`.

name="spt-relay"
description="spt — SMTP relay tunnel"
command="/usr/local/bin/spt"
command_args="service run --config /etc/spt/relay.toml"
command_user="spt:spt"
command_background=true
pidfile="/run/spt-relay.pid"
directory="/var/lib/spt"

depend() {
    need net
    after firewall
}
