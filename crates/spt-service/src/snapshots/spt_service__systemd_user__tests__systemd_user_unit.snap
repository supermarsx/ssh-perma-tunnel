---
source: crates/spt-service/src/systemd_user.rs
expression: out
---
[Unit]
Description=spt — SMTP relay tunnel
Documentation=https://github.com/supermarsx/ssh-perma-tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/spt service run --config /etc/spt/relay.toml
WorkingDirectory=/var/lib/spt
StateDirectory=spt
Environment="RUST_LOG=info"
Environment="SPT_STATE_DIR=/var/lib/spt"


Restart=on-failure
RestartSec=5s
WatchdogSec=30s
# Graceful-stop budget. spt bounds its own aggregate teardown to ~80% of this
# and flushes final status before the slow session teardown, so a clean stop
# always finishes before systemd escalates to SIGKILL. Keep in sync with
# spt_service::RECOMMENDED_STOP_TIMEOUT_SECS.
TimeoutStopSec=45s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
