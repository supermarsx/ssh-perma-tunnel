<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0"
                           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Modèle de stratégie ssh-perma-tunnel (spt)</displayName>
  <description>Modèle d'administration de stratégie de groupe pour l'agent ssh-perma-tunnel.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Spt_1_0">spt 1.0 ou ultérieur</string>

      <string id="Cat_Spt">spt — Tunnel SSH permanent</string>
      <string id="Cat_Spt_Help">Stratégies pour l'agent ssh-perma-tunnel (spt).</string>
      <string id="Cat_General">Général</string>
      <string id="Cat_General_Help">Paramètres généraux de l'agent (répertoire d'état, configuration par défaut, démarrage du service).</string>
      <string id="Cat_Network">Réseau</string>
      <string id="Cat_Network_Help">Points de terminaison réseau, plan de contrôle MCP, épinglage de la configuration distante, restrictions de liaison.</string>
      <string id="Cat_Crypto">Cryptographie</string>
      <string id="Cat_Crypto_Help">Versions SSH autorisées et listes blanches d'algorithmes cryptographiques.</string>
      <string id="Cat_Observability">Observabilité</string>
      <string id="Cat_Observability_Help">Journalisation, métriques et désactivation de la télémétrie.</string>
      <string id="Cat_Security">Sécurité</string>
      <string id="Cat_Security_Help">Backends de secrets et listes blanches d'actions du pare-feu.</string>

      <string id="Pol_StateDir">Répertoire d'état</string>
      <string id="Pol_StateDir_Help">Chemin absolu du répertoire d'état de spt. Remplace la valeur par défaut par utilisateur ou par machine. Exemple : C:\ProgramData\spt\state</string>
      <string id="Pol_DefaultConfigPath">Chemin du fichier de configuration par défaut</string>
      <string id="Pol_DefaultConfigPath_Help">Chemin absolu du fichier de configuration de spt utilisé lorsqu'aucun indicateur --config n'est fourni.</string>
      <string id="Pol_ServiceAutoStart">Démarrer automatiquement le service spt</string>
      <string id="Pol_ServiceAutoStart_Help">Si activé, le service Windows spt est configuré pour démarrer automatiquement au démarrage du système.</string>

      <string id="Pol_RemoteConfigUrlPin">Épinglage de l'URL de configuration distante</string>
      <string id="Pol_RemoteConfigUrlPin_Help">Si défini, l'agent ne récupérera la configuration distante qu'à partir de cette URL exacte. Obligatoire dans les environnements managés utilisant la configuration distante.</string>
      <string id="Pol_RemoteConfigFingerprintSha256">Empreinte TLS de la configuration distante (SHA-256, hex)</string>
      <string id="Pol_RemoteConfigFingerprintSha256_Help">Empreinte SHA-256 (hex en minuscules, sans séparateurs) du certificat TLS feuille devant servir l'URL de configuration distante. Épingle la connexion.</string>
      <string id="Pol_McpEnabled">Activer le plan de contrôle MCP</string>
      <string id="Pol_McpEnabled_Help">Si activé, l'agent expose son point de terminaison MCP (Management Control Protocol).</string>
      <string id="Pol_McpListen">Adresse d'écoute MCP</string>
      <string id="Pol_McpListen_Help">Adresse d'écoute du point de terminaison MCP, p. ex. 127.0.0.1:7843 ou unix:/var/run/spt.sock (sous Windows, des barres obliques sont acceptées pour les canaux nommés via npipe:\\.\pipe\spt).</string>
      <string id="Pol_BindRestrictions">Restrictions de liaison (CIDR)</string>
      <string id="Pol_BindRestrictions_Help">Un CIDR par ligne. Les sockets d'écoute locaux créés par les tunnels ne doivent être accessibles que depuis ces réseaux (typiquement 127.0.0.0/8, ::1/128).</string>

      <string id="Pol_AllowSsh2">Autoriser le protocole SSH version 2</string>
      <string id="Pol_AllowSsh2_Help">Permet à l'agent de négocier des transports SSH-2.</string>
      <string id="Pol_AllowSsh3">Autoriser le protocole SSH version 3 (QUIC/HTTP3)</string>
      <string id="Pol_AllowSsh3_Help">Permet à l'agent de négocier des transports SSH-3 (sur QUIC).</string>
      <string id="Pol_AllowedKexAlgorithms">Algorithmes d'échange de clés autorisés</string>
      <string id="Pol_AllowedKexAlgorithms_Help">Un nom d'algorithme par ligne. Limite les algorithmes KEX proposés/acceptés.</string>
      <string id="Pol_AllowedCiphers">Chiffrements autorisés</string>
      <string id="Pol_AllowedCiphers_Help">Un nom de chiffrement par ligne. Limite les chiffrements symétriques proposés/acceptés.</string>
      <string id="Pol_AllowedMacs">Algorithmes MAC autorisés</string>
      <string id="Pol_AllowedMacs_Help">Un nom MAC par ligne. Limite les algorithmes de code d'authentification de message proposés/acceptés.</string>
      <string id="Pol_AllowedHostKeyTypes">Types de clé d'hôte autorisés</string>
      <string id="Pol_AllowedHostKeyTypes_Help">Un type de clé d'hôte par ligne (p. ex. ssh-ed25519, rsa-sha2-512).</string>

      <string id="Pol_LogLevel">Niveau de journalisation</string>
      <string id="Pol_LogLevel_Help">Sévérité minimale des événements journalisés.</string>
      <string id="LogLevel_Trace">trace</string>
      <string id="LogLevel_Debug">debug</string>
      <string id="LogLevel_Info">info</string>
      <string id="LogLevel_Warn">warn</string>
      <string id="LogLevel_Error">error</string>
      <string id="Pol_LogDestinations">Destinations des journaux</string>
      <string id="Pol_LogDestinations_Help">Une destination par ligne. Exemples : stderr, eventlog, file:C:\ProgramData\spt\logs\spt.log, syslog:udp://10.0.0.1:514</string>
      <string id="Pol_TelemetryOptOut">Désactiver la télémétrie</string>
      <string id="Pol_TelemetryOptOut_Help">Si activé, l'agent désactive toute télémétrie sortante.</string>

      <string id="Pol_AllowedFirewallActions">Actions de pare-feu autorisées</string>
      <string id="Pol_AllowedFirewallActions_Help">Une action par ligne (p. ex. open-listen, open-outbound, none). Restreint les modifications de pare-feu que l'agent peut effectuer.</string>
      <string id="Pol_SecretBackend">Backend de secrets</string>
      <string id="Pol_SecretBackend_Help">Sélectionne où l'agent stocke et récupère les secrets.</string>
      <string id="SecretBackend_Keyring">Gestionnaire d'identifiants Windows (keyring)</string>
      <string id="SecretBackend_File">Fichier chiffré (file)</string>
    </stringTable>

    <presentationTable>
      <presentation id="Pres_StateDir">
        <textBox refId="StateDir"><label>Répertoire d'état :</label></textBox>
      </presentation>
      <presentation id="Pres_DefaultConfigPath">
        <textBox refId="DefaultConfigPath"><label>Chemin du fichier de configuration :</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigUrlPin">
        <textBox refId="RemoteConfigUrlPin"><label>URL :</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigFingerprintSha256">
        <textBox refId="RemoteConfigFingerprintSha256"><label>SHA-256 (hex) :</label></textBox>
      </presentation>
      <presentation id="Pres_McpListen">
        <textBox refId="McpListen"><label>Écouter sur :</label></textBox>
      </presentation>
      <presentation id="Pres_BindRestrictions">
        <multiTextBox refId="BindRestrictions">CIDR (un par ligne) :</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedKexAlgorithms">
        <multiTextBox refId="AllowedKexAlgorithms">Algorithmes KEX (un par ligne) :</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedCiphers">
        <multiTextBox refId="AllowedCiphers">Chiffrements (un par ligne) :</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedMacs">
        <multiTextBox refId="AllowedMacs">MAC (un par ligne) :</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedHostKeyTypes">
        <multiTextBox refId="AllowedHostKeyTypes">Types de clé d'hôte (un par ligne) :</multiTextBox>
      </presentation>
      <presentation id="Pres_LogLevel">
        <dropdownList refId="LogLevel" defaultItem="2">Niveau minimal de journalisation :</dropdownList>
      </presentation>
      <presentation id="Pres_LogDestinations">
        <multiTextBox refId="LogDestinations">Destinations (une par ligne) :</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedFirewallActions">
        <multiTextBox refId="AllowedFirewallActions">Actions autorisées (une par ligne) :</multiTextBox>
      </presentation>
      <presentation id="Pres_SecretBackend">
        <dropdownList refId="SecretBackend" defaultItem="0">Backend :</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
