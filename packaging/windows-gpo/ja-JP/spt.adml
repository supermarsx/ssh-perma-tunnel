<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0"
                           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>ssh-perma-tunnel (spt) ポリシー テンプレート</displayName>
  <description>ssh-perma-tunnel エージェント用のグループ ポリシー管理テンプレートです。</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Spt_1_0">spt 1.0 以降</string>

      <string id="Cat_Spt">spt — SSH 永続トンネル</string>
      <string id="Cat_Spt_Help">ssh-perma-tunnel (spt) エージェント用のポリシーです。</string>
      <string id="Cat_General">全般</string>
      <string id="Cat_General_Help">エージェントの一般設定 (状態ディレクトリ、既定の構成、サービスの開始)。</string>
      <string id="Cat_Network">ネットワーク</string>
      <string id="Cat_Network_Help">ネットワーク エンドポイント、MCP コントロール プレーン、リモート構成のピン留め、バインド制限。</string>
      <string id="Cat_Crypto">暗号</string>
      <string id="Cat_Crypto_Help">許可する SSH バージョンと暗号アルゴリズムの許可リスト。</string>
      <string id="Cat_Observability">可観測性</string>
      <string id="Cat_Observability_Help">ログ記録、メトリック、テレメトリのオプトアウト。</string>
      <string id="Cat_Security">セキュリティ</string>
      <string id="Cat_Security_Help">シークレット バックエンドとホスト ファイアウォール アクションの許可リスト。</string>

      <string id="Pol_StateDir">状態ディレクトリ</string>
      <string id="Pol_StateDir_Help">spt 状態ディレクトリへの絶対パス。ユーザー単位またはコンピューター単位の既定値を上書きします。例: C:\ProgramData\spt\state</string>
      <string id="Pol_DefaultConfigPath">既定の構成ファイル パス</string>
      <string id="Pol_DefaultConfigPath_Help">--config フラグが指定されていない場合に使用される spt 構成ファイルへの絶対パスです。</string>
      <string id="Pol_ServiceAutoStart">spt サービスを自動的に開始する</string>
      <string id="Pol_ServiceAutoStart_Help">有効にすると、spt Windows サービスはブート時に自動的に開始するように構成されます。</string>

      <string id="Pol_RemoteConfigUrlPin">リモート構成 URL のピン留め</string>
      <string id="Pol_RemoteConfigUrlPin_Help">設定されている場合、エージェントはこの完全一致の URL からのみリモート構成を取得します。マネージド環境でリモート構成を使用する場合は必須です。</string>
      <string id="Pol_RemoteConfigFingerprintSha256">リモート構成の TLS フィンガープリント (SHA-256, hex)</string>
      <string id="Pol_RemoteConfigFingerprintSha256_Help">リモート構成 URL を提供する TLS リーフ証明書の SHA-256 フィンガープリント (小文字 hex、区切り文字なし)。接続をピン留めします。</string>
      <string id="Pol_McpEnabled">MCP コントロール プレーンを有効にする</string>
      <string id="Pol_McpEnabled_Help">有効にすると、エージェントは MCP (Management Control Protocol) エンドポイントを公開します。</string>
      <string id="Pol_McpListen">MCP リッスン アドレス</string>
      <string id="Pol_McpListen_Help">MCP エンドポイントのリッスン アドレス。例: 127.0.0.1:7843、または unix:/var/run/spt.sock (Windows では名前付きパイプ用にスラッシュが受け入れられます (npipe:\\.\pipe\spt))。</string>
      <string id="Pol_BindRestrictions">バインド制限 (CIDR)</string>
      <string id="Pol_BindRestrictions_Help">1 行に 1 つの CIDR。トンネルが作成するローカル リッスン ソケットは、これらのネットワーク (通常は 127.0.0.0/8、::1/128) からのみ到達可能でなければなりません。</string>

      <string id="Pol_AllowSsh2">SSH プロトコル バージョン 2 を許可する</string>
      <string id="Pol_AllowSsh2_Help">エージェントが SSH-2 トランスポートをネゴシエートすることを許可します。</string>
      <string id="Pol_AllowSsh3">SSH プロトコル バージョン 3 (QUIC/HTTP3) を許可する</string>
      <string id="Pol_AllowSsh3_Help">エージェントが SSH-3 (QUIC 上) トランスポートをネゴシエートすることを許可します。</string>
      <string id="Pol_AllowedKexAlgorithms">許可する鍵交換アルゴリズム</string>
      <string id="Pol_AllowedKexAlgorithms_Help">1 行に 1 つのアルゴリズム名。提供/受け入れる KEX アルゴリズムを制限します。</string>
      <string id="Pol_AllowedCiphers">許可する暗号</string>
      <string id="Pol_AllowedCiphers_Help">1 行に 1 つの暗号名。提供/受け入れる対称暗号を制限します。</string>
      <string id="Pol_AllowedMacs">許可する MAC アルゴリズム</string>
      <string id="Pol_AllowedMacs_Help">1 行に 1 つの MAC 名。提供/受け入れるメッセージ認証コード アルゴリズムを制限します。</string>
      <string id="Pol_AllowedHostKeyTypes">許可するホスト キーの種類</string>
      <string id="Pol_AllowedHostKeyTypes_Help">1 行に 1 つのホスト キーの種類 (例: ssh-ed25519、rsa-sha2-512)。</string>

      <string id="Pol_LogLevel">ログ レベル</string>
      <string id="Pol_LogLevel_Help">記録するイベントの最小重大度です。</string>
      <string id="LogLevel_Trace">trace</string>
      <string id="LogLevel_Debug">debug</string>
      <string id="LogLevel_Info">info</string>
      <string id="LogLevel_Warn">warn</string>
      <string id="LogLevel_Error">error</string>
      <string id="Pol_LogDestinations">ログの出力先</string>
      <string id="Pol_LogDestinations_Help">1 行に 1 つの出力先。例: stderr、eventlog、file:C:\ProgramData\spt\logs\spt.log、syslog:udp://10.0.0.1:514</string>
      <string id="Pol_TelemetryOptOut">テレメトリをオプトアウトする</string>
      <string id="Pol_TelemetryOptOut_Help">有効にすると、エージェントはすべての送信テレメトリを無効にします。</string>

      <string id="Pol_AllowedFirewallActions">許可するファイアウォール アクション</string>
      <string id="Pol_AllowedFirewallActions_Help">1 行に 1 つのアクション (例: open-listen、open-outbound、none)。エージェントが実行できるファイアウォール変更を制限します。</string>
      <string id="Pol_SecretBackend">シークレット バックエンド</string>
      <string id="Pol_SecretBackend_Help">エージェントがシークレットを保存および取得する場所を選択します。</string>
      <string id="SecretBackend_Keyring">Windows 資格情報マネージャー (keyring)</string>
      <string id="SecretBackend_File">暗号化ファイル (file)</string>
    </stringTable>

    <presentationTable>
      <presentation id="Pres_StateDir">
        <textBox refId="StateDir"><label>状態ディレクトリ:</label></textBox>
      </presentation>
      <presentation id="Pres_DefaultConfigPath">
        <textBox refId="DefaultConfigPath"><label>構成ファイル パス:</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigUrlPin">
        <textBox refId="RemoteConfigUrlPin"><label>URL:</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigFingerprintSha256">
        <textBox refId="RemoteConfigFingerprintSha256"><label>SHA-256 (hex):</label></textBox>
      </presentation>
      <presentation id="Pres_McpListen">
        <textBox refId="McpListen"><label>リッスン:</label></textBox>
      </presentation>
      <presentation id="Pres_BindRestrictions">
        <multiTextBox refId="BindRestrictions">CIDR (1 行に 1 つ):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedKexAlgorithms">
        <multiTextBox refId="AllowedKexAlgorithms">KEX アルゴリズム (1 行に 1 つ):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedCiphers">
        <multiTextBox refId="AllowedCiphers">暗号 (1 行に 1 つ):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedMacs">
        <multiTextBox refId="AllowedMacs">MAC (1 行に 1 つ):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedHostKeyTypes">
        <multiTextBox refId="AllowedHostKeyTypes">ホスト キーの種類 (1 行に 1 つ):</multiTextBox>
      </presentation>
      <presentation id="Pres_LogLevel">
        <dropdownList refId="LogLevel" defaultItem="2">最小ログ レベル:</dropdownList>
      </presentation>
      <presentation id="Pres_LogDestinations">
        <multiTextBox refId="LogDestinations">出力先 (1 行に 1 つ):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedFirewallActions">
        <multiTextBox refId="AllowedFirewallActions">許可するアクション (1 行に 1 つ):</multiTextBox>
      </presentation>
      <presentation id="Pres_SecretBackend">
        <dropdownList refId="SecretBackend" defaultItem="0">バックエンド:</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
