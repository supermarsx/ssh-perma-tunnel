<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0"
                           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>ssh-perma-tunnel (spt) policy template</displayName>
  <description>Group Policy administrative template for the ssh-perma-tunnel agent.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Spt_1_0">spt 1.0 or later</string>

      <string id="Cat_Spt">spt — SSH Permanent Tunnel</string>
      <string id="Cat_Spt_Help">Policies for the ssh-perma-tunnel (spt) agent.</string>
      <string id="Cat_General">General</string>
      <string id="Cat_General_Help">General agent settings (state directory, default config, service start).</string>
      <string id="Cat_Network">Network</string>
      <string id="Cat_Network_Help">Network endpoints, MCP control plane, remote-config pinning, bind restrictions.</string>
      <string id="Cat_Crypto">Crypto</string>
      <string id="Cat_Crypto_Help">Allowed SSH versions and cryptographic algorithm allow-lists.</string>
      <string id="Cat_Observability">Observability</string>
      <string id="Cat_Observability_Help">Logging, metrics, and telemetry opt-out.</string>
      <string id="Cat_Security">Security</string>
      <string id="Cat_Security_Help">Secret backends and host firewall action allow-lists.</string>

      <string id="Pol_StateDir">State directory</string>
      <string id="Pol_StateDir_Help">Absolute path to the spt state directory. Overrides the per-user/per-machine default. Example: C:\ProgramData\spt\state</string>
      <string id="Pol_DefaultConfigPath">Default configuration file path</string>
      <string id="Pol_DefaultConfigPath_Help">Absolute path to the spt configuration file used when no --config flag is given.</string>
      <string id="Pol_ServiceAutoStart">Auto-start spt service</string>
      <string id="Pol_ServiceAutoStart_Help">When enabled, the spt Windows service is configured for automatic start at boot.</string>

      <string id="Pol_RemoteConfigUrlPin">Remote config URL pin</string>
      <string id="Pol_RemoteConfigUrlPin_Help">If set, the agent will only fetch remote configuration from this exact URL. Required when remote config is in use under managed environments.</string>
      <string id="Pol_RemoteConfigFingerprintSha256">Remote config TLS fingerprint (SHA-256, hex)</string>
      <string id="Pol_RemoteConfigFingerprintSha256_Help">SHA-256 fingerprint (lowercase hex, no separators) of the TLS leaf certificate that must serve the remote-config URL. Pins the connection.</string>
      <string id="Pol_McpEnabled">Enable MCP control plane</string>
      <string id="Pol_McpEnabled_Help">When enabled, the agent exposes its MCP (Management Control Protocol) endpoint.</string>
      <string id="Pol_McpListen">MCP listen address</string>
      <string id="Pol_McpListen_Help">Listen address for the MCP endpoint, e.g. 127.0.0.1:7843 or unix:/var/run/spt.sock (forward slashes accepted on Windows for named pipes via npipe:\\.\pipe\spt).</string>
      <string id="Pol_BindRestrictions">Bind restrictions (CIDRs)</string>
      <string id="Pol_BindRestrictions_Help">One CIDR per line. Local listen sockets created by tunnels must be reachable only from within these networks (typically 127.0.0.0/8, ::1/128).</string>

      <string id="Pol_AllowSsh2">Allow SSH protocol version 2</string>
      <string id="Pol_AllowSsh2_Help">Permit the agent to negotiate SSH-2 transports.</string>
      <string id="Pol_AllowSsh3">Allow SSH protocol version 3 (QUIC/HTTP3)</string>
      <string id="Pol_AllowSsh3_Help">Permit the agent to negotiate SSH-3 (over QUIC) transports.</string>
      <string id="Pol_AllowedKexAlgorithms">Allowed key-exchange algorithms</string>
      <string id="Pol_AllowedKexAlgorithms_Help">One algorithm name per line. Limits the KEX algorithms offered/accepted.</string>
      <string id="Pol_AllowedCiphers">Allowed ciphers</string>
      <string id="Pol_AllowedCiphers_Help">One cipher name per line. Limits the symmetric ciphers offered/accepted.</string>
      <string id="Pol_AllowedMacs">Allowed MAC algorithms</string>
      <string id="Pol_AllowedMacs_Help">One MAC name per line. Limits the message-authentication-code algorithms offered/accepted.</string>
      <string id="Pol_AllowedHostKeyTypes">Allowed host-key types</string>
      <string id="Pol_AllowedHostKeyTypes_Help">One host-key type per line (e.g. ssh-ed25519, rsa-sha2-512).</string>

      <string id="Pol_LogLevel">Log level</string>
      <string id="Pol_LogLevel_Help">Minimum severity for logged events.</string>
      <string id="LogLevel_Trace">trace</string>
      <string id="LogLevel_Debug">debug</string>
      <string id="LogLevel_Info">info</string>
      <string id="LogLevel_Warn">warn</string>
      <string id="LogLevel_Error">error</string>
      <string id="Pol_LogDestinations">Log destinations</string>
      <string id="Pol_LogDestinations_Help">One destination per line. Examples: stderr, eventlog, file:C:\ProgramData\spt\logs\spt.log, syslog:udp://10.0.0.1:514</string>
      <string id="Pol_TelemetryOptOut">Opt out of telemetry</string>
      <string id="Pol_TelemetryOptOut_Help">When enabled, the agent disables all outbound telemetry.</string>

      <string id="Pol_AllowedFirewallActions">Allowed firewall actions</string>
      <string id="Pol_AllowedFirewallActions_Help">One action per line (e.g. open-listen, open-outbound, none). Restricts which firewall mutations the agent may perform.</string>
      <string id="Pol_SecretBackend">Secret backend</string>
      <string id="Pol_SecretBackend_Help">Selects where the agent stores and retrieves secrets.</string>
      <string id="SecretBackend_Keyring">Windows Credential Manager (keyring)</string>
      <string id="SecretBackend_File">Encrypted file (file)</string>
    </stringTable>

    <presentationTable>
      <presentation id="Pres_StateDir">
        <textBox refId="StateDir"><label>State directory:</label></textBox>
      </presentation>
      <presentation id="Pres_DefaultConfigPath">
        <textBox refId="DefaultConfigPath"><label>Config file path:</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigUrlPin">
        <textBox refId="RemoteConfigUrlPin"><label>URL:</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigFingerprintSha256">
        <textBox refId="RemoteConfigFingerprintSha256"><label>SHA-256 (hex):</label></textBox>
      </presentation>
      <presentation id="Pres_McpListen">
        <textBox refId="McpListen"><label>Listen:</label></textBox>
      </presentation>
      <presentation id="Pres_BindRestrictions">
        <multiTextBox refId="BindRestrictions">CIDRs (one per line):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedKexAlgorithms">
        <multiTextBox refId="AllowedKexAlgorithms">KEX algorithms (one per line):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedCiphers">
        <multiTextBox refId="AllowedCiphers">Ciphers (one per line):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedMacs">
        <multiTextBox refId="AllowedMacs">MACs (one per line):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedHostKeyTypes">
        <multiTextBox refId="AllowedHostKeyTypes">Host-key types (one per line):</multiTextBox>
      </presentation>
      <presentation id="Pres_LogLevel">
        <dropdownList refId="LogLevel" defaultItem="2">Minimum log level:</dropdownList>
      </presentation>
      <presentation id="Pres_LogDestinations">
        <multiTextBox refId="LogDestinations">Destinations (one per line):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedFirewallActions">
        <multiTextBox refId="AllowedFirewallActions">Allowed actions (one per line):</multiTextBox>
      </presentation>
      <presentation id="Pres_SecretBackend">
        <dropdownList refId="SecretBackend" defaultItem="0">Backend:</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
