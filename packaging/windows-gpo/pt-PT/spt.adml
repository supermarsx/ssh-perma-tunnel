<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0"
                           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Modelo de política ssh-perma-tunnel (spt)</displayName>
  <description>Modelo administrativo de política de grupo para o agente ssh-perma-tunnel.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Spt_1_0">spt 1.0 ou posterior</string>

      <string id="Cat_Spt">spt — Túnel SSH permanente</string>
      <string id="Cat_Spt_Help">Políticas para o agente ssh-perma-tunnel (spt).</string>
      <string id="Cat_General">Geral</string>
      <string id="Cat_General_Help">Definições gerais do agente (diretório de estado, configuração predefinida, arranque do serviço).</string>
      <string id="Cat_Network">Rede</string>
      <string id="Cat_Network_Help">Pontos de rede, plano de controlo MCP, fixação da configuração remota, restrições de associação.</string>
      <string id="Cat_Crypto">Criptografia</string>
      <string id="Cat_Crypto_Help">Versões SSH permitidas e listas de algoritmos criptográficos permitidos.</string>
      <string id="Cat_Observability">Observabilidade</string>
      <string id="Cat_Observability_Help">Registo, métricas e exclusão de telemetria.</string>
      <string id="Cat_Security">Segurança</string>
      <string id="Cat_Security_Help">Backends de segredos e listas de ações de firewall permitidas.</string>

      <string id="Pol_StateDir">Diretório de estado</string>
      <string id="Pol_StateDir_Help">Caminho absoluto para o diretório de estado do spt. Substitui o valor predefinido por utilizador ou por máquina. Exemplo: C:\ProgramData\spt\state</string>
      <string id="Pol_DefaultConfigPath">Caminho do ficheiro de configuração predefinido</string>
      <string id="Pol_DefaultConfigPath_Help">Caminho absoluto para o ficheiro de configuração do spt utilizado quando não é indicado o parâmetro --config.</string>
      <string id="Pol_ServiceAutoStart">Iniciar automaticamente o serviço spt</string>
      <string id="Pol_ServiceAutoStart_Help">Quando ativada, o serviço spt do Windows é configurado para arranque automático no arranque do sistema.</string>

      <string id="Pol_RemoteConfigUrlPin">Fixação do URL de configuração remota</string>
      <string id="Pol_RemoteConfigUrlPin_Help">Se definido, o agente apenas obterá configuração remota a partir deste URL exato. Obrigatório quando a configuração remota é utilizada em ambientes geridos.</string>
      <string id="Pol_RemoteConfigFingerprintSha256">Impressão digital TLS da configuração remota (SHA-256, hex)</string>
      <string id="Pol_RemoteConfigFingerprintSha256_Help">Impressão digital SHA-256 (hex em minúsculas, sem separadores) do certificado TLS folha que deve servir o URL de configuração remota. Fixa a ligação.</string>
      <string id="Pol_McpEnabled">Ativar plano de controlo MCP</string>
      <string id="Pol_McpEnabled_Help">Quando ativado, o agente expõe o seu ponto MCP (Management Control Protocol).</string>
      <string id="Pol_McpListen">Endereço de escuta MCP</string>
      <string id="Pol_McpListen_Help">Endereço de escuta para o ponto MCP, p. ex. 127.0.0.1:7843 ou unix:/var/run/spt.sock (no Windows aceitam-se barras para tubos com nome via npipe:\\.\pipe\spt).</string>
      <string id="Pol_BindRestrictions">Restrições de associação (CIDR)</string>
      <string id="Pol_BindRestrictions_Help">Um CIDR por linha. Os sockets de escuta locais criados pelos túneis só devem ser acessíveis a partir destas redes (tipicamente 127.0.0.0/8, ::1/128).</string>

      <string id="Pol_AllowSsh2">Permitir o protocolo SSH versão 2</string>
      <string id="Pol_AllowSsh2_Help">Permite ao agente negociar transportes SSH-2.</string>
      <string id="Pol_AllowSsh3">Permitir o protocolo SSH versão 3 (QUIC/HTTP3)</string>
      <string id="Pol_AllowSsh3_Help">Permite ao agente negociar transportes SSH-3 (sobre QUIC).</string>
      <string id="Pol_AllowedKexAlgorithms">Algoritmos de troca de chaves permitidos</string>
      <string id="Pol_AllowedKexAlgorithms_Help">Um nome de algoritmo por linha. Limita os algoritmos KEX oferecidos/aceites.</string>
      <string id="Pol_AllowedCiphers">Cifras permitidas</string>
      <string id="Pol_AllowedCiphers_Help">Um nome de cifra por linha. Limita as cifras simétricas oferecidas/aceites.</string>
      <string id="Pol_AllowedMacs">Algoritmos MAC permitidos</string>
      <string id="Pol_AllowedMacs_Help">Um nome MAC por linha. Limita os algoritmos de código de autenticação de mensagens oferecidos/aceites.</string>
      <string id="Pol_AllowedHostKeyTypes">Tipos de chave de anfitrião permitidos</string>
      <string id="Pol_AllowedHostKeyTypes_Help">Um tipo de chave de anfitrião por linha (p. ex. ssh-ed25519, rsa-sha2-512).</string>

      <string id="Pol_LogLevel">Nível de registo</string>
      <string id="Pol_LogLevel_Help">Severidade mínima dos eventos registados.</string>
      <string id="LogLevel_Trace">trace</string>
      <string id="LogLevel_Debug">debug</string>
      <string id="LogLevel_Info">info</string>
      <string id="LogLevel_Warn">warn</string>
      <string id="LogLevel_Error">error</string>
      <string id="Pol_LogDestinations">Destinos de registo</string>
      <string id="Pol_LogDestinations_Help">Um destino por linha. Exemplos: stderr, eventlog, file:C:\ProgramData\spt\logs\spt.log, syslog:udp://10.0.0.1:514</string>
      <string id="Pol_TelemetryOptOut">Excluir telemetria</string>
      <string id="Pol_TelemetryOptOut_Help">Quando ativado, o agente desativa toda a telemetria de saída.</string>

      <string id="Pol_AllowedFirewallActions">Ações de firewall permitidas</string>
      <string id="Pol_AllowedFirewallActions_Help">Uma ação por linha (p. ex. open-listen, open-outbound, none). Restringe as alterações de firewall que o agente pode efetuar.</string>
      <string id="Pol_SecretBackend">Backend de segredos</string>
      <string id="Pol_SecretBackend_Help">Seleciona onde o agente armazena e obtém os segredos.</string>
      <string id="SecretBackend_Keyring">Gestor de credenciais do Windows (keyring)</string>
      <string id="SecretBackend_File">Ficheiro cifrado (file)</string>
    </stringTable>

    <presentationTable>
      <presentation id="Pres_StateDir">
        <textBox refId="StateDir"><label>Diretório de estado:</label></textBox>
      </presentation>
      <presentation id="Pres_DefaultConfigPath">
        <textBox refId="DefaultConfigPath"><label>Caminho do ficheiro de configuração:</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigUrlPin">
        <textBox refId="RemoteConfigUrlPin"><label>URL:</label></textBox>
      </presentation>
      <presentation id="Pres_RemoteConfigFingerprintSha256">
        <textBox refId="RemoteConfigFingerprintSha256"><label>SHA-256 (hex):</label></textBox>
      </presentation>
      <presentation id="Pres_McpListen">
        <textBox refId="McpListen"><label>Escutar em:</label></textBox>
      </presentation>
      <presentation id="Pres_BindRestrictions">
        <multiTextBox refId="BindRestrictions">CIDR (um por linha):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedKexAlgorithms">
        <multiTextBox refId="AllowedKexAlgorithms">Algoritmos KEX (um por linha):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedCiphers">
        <multiTextBox refId="AllowedCiphers">Cifras (uma por linha):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedMacs">
        <multiTextBox refId="AllowedMacs">MAC (um por linha):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedHostKeyTypes">
        <multiTextBox refId="AllowedHostKeyTypes">Tipos de chave de anfitrião (um por linha):</multiTextBox>
      </presentation>
      <presentation id="Pres_LogLevel">
        <dropdownList refId="LogLevel" defaultItem="2">Nível mínimo de registo:</dropdownList>
      </presentation>
      <presentation id="Pres_LogDestinations">
        <multiTextBox refId="LogDestinations">Destinos (um por linha):</multiTextBox>
      </presentation>
      <presentation id="Pres_AllowedFirewallActions">
        <multiTextBox refId="AllowedFirewallActions">Ações permitidas (uma por linha):</multiTextBox>
      </presentation>
      <presentation id="Pres_SecretBackend">
        <dropdownList refId="SecretBackend" defaultItem="0">Backend:</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
