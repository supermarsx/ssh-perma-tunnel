#!/sbin/openrc-run
# OpenRC init script for {{name}}
# Generated by spt — do not edit by hand; re-run `spt service install`.

name="{{name}}"
description="{{description}}"
command="{{exec_path}}"
command_args="{{args}}"
command_user="{{user}}:{{group}}"
# Supervision / restart policy (from ServiceSpec.restart_policy):
#   always / on-failure -> supervise-daemon respawns the process if it exits
#   never               -> plain backgrounded start-stop-daemon (no respawn)
{{supervisor_directives}}
pidfile="/run/{{name}}.pid"
directory="{{working_dir}}"

# Environment exports from [profiles].env (blank when none configured).
{{env_exports}}

depend() {
    need net
    after firewall
}
