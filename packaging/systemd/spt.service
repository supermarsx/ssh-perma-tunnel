[Unit]
Description=SSH permanent tunnel (spt)
Documentation=https://github.com/supermarsx/ssh-perma-tunnel
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify: the spt binary sends sd_notify READY=1 once the orchestrator is
# up and STOPPING=1 at the start of an orderly shutdown, via $NOTIFY_SOCKET
# (see spt-service::systemd_notify; no libsystemd dependency).
#
# WatchdogSec: systemd exports $WATCHDOG_USEC and spt sends WATCHDOG=1 at half
# the interval (a bounded, non-blocking pinger; see spt-service::systemd_notify).
# A wedged process is then detected and restarted within one interval. Keep in
# sync with spt_service::RECOMMENDED_WATCHDOG_SECS; set to 0/remove to disable.
Type=notify
# Only the main process emits notifications.
NotifyAccess=main
ExecStart=/usr/bin/spt tunnel run --foreground --config /etc/spt/spt.toml
ExecReload=/usr/bin/spt tunnel reload
WorkingDirectory=/var/lib/spt
Environment=SPT_STATE_DIR=/var/lib/spt
Environment=RUST_LOG=info
User=spt
Group=spt
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
# Graceful-stop budget. spt bounds its own aggregate teardown to ~80% of this
# and flushes final status before the slow session teardown, so a clean stop
# always finishes before systemd escalates to SIGKILL. Keep in sync with
# spt_service::RECOMMENDED_STOP_TIMEOUT_SECS.
TimeoutStopSec=45s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/spt /var/log/spt
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
