[Unit]
Description=SSH permanent tunnel (spt)
Documentation=https://github.com/supermarsx/ssh-perma-tunnel
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple: the spt binary does not yet send sd_notify READY=1 / STOPPING=1.
# Using Type=notify here causes systemd to wait for a readiness notification
# that never arrives, time out (~90s), and kill+restart the service forever.
# TODO(E7-F3 / E8-F3): switch back to Type=notify once a NOTIFY_SOCKET writer
# (READY=1 after orchestrator bring-up, STOPPING=1 on shutdown) is implemented.
Type=simple
ExecStart=/usr/bin/spt tunnel run --foreground --config /etc/spt/spt.toml
ExecReload=/usr/bin/spt tunnel reload
WorkingDirectory=/var/lib/spt
Environment=SPT_STATE_DIR=/var/lib/spt
Environment=RUST_LOG=info
User=spt
Group=spt
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/spt /var/log/spt
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
