# Maintainer: Mariana <noreply@example.com>
#
# Source-build AUR package. Compiles `spt` from a tagged GitHub release tarball.
# See `PKGBUILD-bin` for the pre-built binary variant.
#
# Placeholders substituted by `scripts/release/update-packaging.sh`:
#   <VERSION>          — release version, e.g. 0.1.0
#   <SHA256_SRC_TAR>   — sha256 of v<VERSION>.tar.gz from GitHub
pkgname=spt
pkgver=<VERSION>
pkgrel=1
pkgdesc="Permanent SSH/SSH3 tunnels — local/remote port forwards that survive drops"
arch=('x86_64' 'aarch64')
url="https://github.com/supermarsx/ssh-perma-tunnel"
license=('MIT')
depends=('gcc-libs' 'openssl')
makedepends=('cargo' 'pkgconf')
optdepends=(
    'systemd: service integration via packaging/systemd/spt.service'
)
provides=('spt')
conflicts=('spt-bin' 'spt-git')
source=("$pkgname-$pkgver.tar.gz::https://github.com/supermarsx/ssh-perma-tunnel/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('<SHA256_SRC_TAR>')

prepare() {
    cd "ssh-perma-tunnel-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "ssh-perma-tunnel-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --bin spt
}

check() {
    cd "ssh-perma-tunnel-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --bin spt -- --skip integration
}

package() {
    cd "ssh-perma-tunnel-${pkgver}"

    install -Dm755 "target/release/spt"          "$pkgdir/usr/bin/spt"
    install -Dm644 "license.md"                  "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "readme.md"                   "$pkgdir/usr/share/doc/$pkgname/readme.md"
    install -Dm644 "packaging/systemd/spt.service" \
        "$pkgdir/usr/lib/systemd/system/spt.service"

    # Man pages (committed under packaging/man).
    for page in packaging/man/spt*.1; do
        install -Dm644 "$page" "$pkgdir/usr/share/man/man1/$(basename "$page")"
    done

    # Shell completions, generated from the freshly built binary.
    install -dm755 "$pkgdir/usr/share/bash-completion/completions"
    install -dm755 "$pkgdir/usr/share/zsh/site-functions"
    install -dm755 "$pkgdir/usr/share/fish/vendor_completions.d"
    install -dm755 "$pkgdir/usr/share/powershell/Modules/spt"
    install -dm755 "$pkgdir/usr/share/elvish/lib"
    "target/release/spt" completion generate bash > "$pkgdir/usr/share/bash-completion/completions/spt"      || true
    "target/release/spt" completion generate zsh  > "$pkgdir/usr/share/zsh/site-functions/_spt"             || true
    "target/release/spt" completion generate fish > "$pkgdir/usr/share/fish/vendor_completions.d/spt.fish"  || true
    "target/release/spt" completion generate powershell > "$pkgdir/usr/share/powershell/Modules/spt/spt.psm1" || true
    "target/release/spt" completion generate elvish > "$pkgdir/usr/share/elvish/lib/spt.elv" || true
}
