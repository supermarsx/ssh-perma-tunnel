.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH SPT-FTP 1  "ftp " 
.SH NAME
ftp \- FTP→SFTP translator service
.SH SYNOPSIS
\fBftp\fR [\fB\-h\fR|\fB\-\-help\fR] <\fIsubcommands\fR>
.SH DESCRIPTION
FTP→SFTP translator service
.SH OPTIONS
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.SH SUBCOMMANDS
.TP
ftp\-translator(1)
Run / manage the FTP→SFTP translator service
.TP
ftp\-help(1)
Print this message or the help of the given subcommand(s)
.SH EXTRA
EXAMPLES:
  spt ftp translator serve \-\-bind 0.0.0.0:2121 \-\-pasv\-range 50000\-50100 \-\-profile edge
  spt ftp translator serve \-\-bind 127.0.0.1:21 \\
      \-\-pasv\-range 50000\-50100 \\
      \-\-tls\-cert /etc/spt/ftp.crt \-\-tls\-key /etc/spt/ftp.key \\
      \-\-profile edge
