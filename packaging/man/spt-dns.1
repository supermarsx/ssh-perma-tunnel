.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH SPT-DNS 1  "dns " 
.SH NAME
dns \- Built\-in DNS resolver and hosts\-file management
.SH SYNOPSIS
\fBdns\fR [\fB\-h\fR|\fB\-\-help\fR] <\fIsubcommands\fR>
.SH DESCRIPTION
Built\-in DNS resolver and hosts\-file management
.SH OPTIONS
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.SH SUBCOMMANDS
.TP
dns\-serve(1)
Run the resolver
.TP
dns\-status(1)
Resolver status
.TP
dns\-query(1)
Issue a query against the configured resolver
.TP
dns\-upstream(1)
Manage upstream resolvers
.TP
dns\-record(1)
Manage managed records
.TP
dns\-hosts(1)
Manage hosts\-file rendering / apply / restore
.TP
dns\-help(1)
Print this message or the help of the given subcommand(s)
.SH EXTRA
EXAMPLES:
  spt dns serve \-\-foreground
  spt dns record add svc.local \-\-addr 10.0.0.1 \-\-ttl 5m
  spt dns hosts render \-\-out /etc/hosts.spt
  spt dns hosts apply \-\-backup
  spt dns hosts restore \-\-backup /var/lib/spt/hosts/backup\-2024\-01\-01
