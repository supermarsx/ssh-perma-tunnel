# packaging/docker/.env.example
#
# Copy to `.env` next to docker-compose.yml. Values here are interpolated
# into the compose file at `up` time.

# Image tag. Pin to a release for prod; `latest` is fine for trying it out.
SPT_VERSION=latest

# Override if you pull from a private registry or a fork.
# SPT_IMAGE=ghcr.io/mariana/spt:${SPT_VERSION}

# Log verbosity. spt honours both SPT_LOG_LEVEL and RUST_LOG; the latter
# wins when set. Valid levels: error | warn | info | debug | trace.
SPT_LOG_LEVEL=info
RUST_LOG=info

# Forward port mappings. Each pair is `<host-bind>:<container-port>`. Bind
# to 127.0.0.1 unless you really want the forward exposed on the LAN.
SPT_FORWARD_PORT_1=127.0.0.1:8080
# SPT_FORWARD_PORT_2=127.0.0.1:8443

# Dev overlay only. Path to the binary mounted into the container by
# docker-compose.dev.yml. Relative to packaging/docker/.
# SPT_DEV_BINARY=../../target/release/spt
